# Auto detect text files and normalize line endings to LF
* text=auto
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.go text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary

# Files read by make/Docker/sh must keep LF on Windows checkouts
Dockerfile text eol=lf
Makefile text eol=lf
VERSION text eol=lf
.dockerignore text eol=lf
